# Banco de dados — driver @libsql/client nos dois cenários.
#   Desenvolvimento: SQLite local, token vazio.
#     TURSO_DATABASE_URL=file:./.data/dev.db
#     TURSO_AUTH_TOKEN=
#   Produção: Turso.
#     TURSO_DATABASE_URL=libsql://<seu-db>.turso.io
#     TURSO_AUTH_TOKEN=<token>
TURSO_DATABASE_URL=file:./.data/dev.db
TURSO_AUTH_TOKEN=

# Chave da API do LLM (Gemini 2.0 Flash ou Claude Haiku) — usada só em T05+.
LLM_API_KEY=

# Segredo para assinar o cookie de sessão (nuxt-auth-utils). Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Fuso horário do dia-calendário da tentativa diária (SPEC.md §6.3).
GAME_TIMEZONE=America/Sao_Paulo
